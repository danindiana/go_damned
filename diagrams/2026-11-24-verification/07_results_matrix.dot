    t [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10" COLOR="#30363d" BGCOLOR="#161b22">
  <TR>
    <TD BGCOLOR="#0d2e2e"><FONT COLOR="#39c5cf"><B>Check</B></FONT></TD>
